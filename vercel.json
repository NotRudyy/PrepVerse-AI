{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "prepverse": {
      "root": "apps/prepverse",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/prepverse-api",
      "entrypoint": "index.py",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "prepverse"
      }
    }
  ]
}